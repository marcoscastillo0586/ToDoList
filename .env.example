# =============================================================================
# Copiar este archivo a .env y completar. Nunca subir .env al repositorio.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Conexión a MySQL: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Si la contraseña tiene caracteres especiales (@ : / # ?), codificalos (ej. @ → %40).
DATABASE_URL="mysql://USUARIO:CONTRASENA@127.0.0.1:3306/todolist"

# --- Ejecución ---------------------------------------------------------------
# Modo: "production" (requiere `npm run build` antes de `npm start`) o "development".
NODE_ENV=development

# Puerto donde escucha la app.
PORT=3001

# Dirección donde escucha la app. En producción detrás de un proxy inverso
# conviene 127.0.0.1 (solo accesible desde el mismo servidor).
# Por defecto: 127.0.0.1 en producción y localhost en desarrollo.
HOST=localhost

# --- Proxy inverso y dominio -------------------------------------------------
# Dirección pública de la app, tal como la escribe el usuario en el navegador
# (protocolo + dominio [+ puerto], sin barra final). Se usa para rechazar
# pedidos de otros sitios (CSRF). Obligatoria en producción.
# Desarrollo: http://localhost:3001 (o vacío: se deduce del pedido).
APP_ORIGIN=http://localhost:3001

# true si la app está detrás de un proxy inverso (Nginx, Apache...) que envía
# X-Forwarded-For y X-Forwarded-Proto. Necesario para conocer la IP real del
# cliente (límite de intentos de login por IP). Si la app está expuesta directo
# a internet, dejarlo en false: cualquiera podría falsificar esos encabezados.
TRUST_PROXY=false

# --- Sesión y cookies --------------------------------------------------------
# true = las cookies solo viajan por HTTPS (atributo Secure).
# Por defecto: true en producción y false en desarrollo (para probar sin HTTPS).
COOKIE_SECURE=false

# Clave secreta para firmar el token CSRF. Obligatoria en producción (mínimo 32 caracteres).
# Generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Minutos sin actividad tras los cuales la sesión vence. Mientras se usa la app, se renueva sola.
SESSION_IDLE_MINUTES=25

# Vida máxima de la sesión en horas; también se renueva con cada uso.
SESSION_TTL_HOURS=4

# --- Límite de intentos de login ---------------------------------------------
# Intentos fallidos permitidos (por correo y por IP) dentro de la ventana de tiempo.
# Al llegar al límite se bloquea hasta que los fallos salen de la ventana.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
